NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://businessos:businessos@localhost:5433/businessos_dev?schema=public
# Host port is 5433 (see docker-compose.yml) — a native Postgres install on
# 5432 is common on Windows/Mac dev machines and would silently steal the connection.
TEST_DATABASE_URL=postgresql://businessos:businessos@localhost:5433/businessos_test?schema=public

JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="BusinessOS <no-reply@businessos.local>"

BCRYPT_SALT_ROUNDS=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
