datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BusinessRole {
  OWNER
  MANAGER
  CASHIER
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementReason {
  OPENING_BALANCE
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String?    @map("first_name")
  lastName          String?    @map("last_name")
  isEmailVerified   Boolean    @default(false) @map("is_email_verified")
  globalRole        GlobalRole @default(USER) @map("global_role")
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         Invitation[]
  recordedStockMovements  InventoryMovement[]
  createdPurchases        Purchase[]

  @@map("users")
}

model Business {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  phone     String?
  email     String?
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  invitations        Invitation[]
  categories         Category[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]

  @@map("businesses")
}

model Category {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([businessId])
  @@map("categories")
}

model Product {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String        @map("business_id") @db.Uuid
  categoryId   String?       @map("category_id") @db.Uuid
  name         String
  sku          String?
  barcode      String?
  description  String?
  costPrice    Decimal       @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal       @default(0) @map("selling_price") @db.Decimal(12, 2)
  taxRate      Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  minStock     Int           @default(0) @map("min_stock")
  imageUrl     String?       @map("image_url")
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, categoryId])
  @@map("products")
}

model Supplier {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([businessId])
  @@map("suppliers")
}

model Purchase {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  supplierId      String         @map("supplier_id") @db.Uuid
  status          PurchaseStatus @default(PENDING)
  note            String?
  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  receivedAt      DateTime?      @map("received_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items     PurchaseItem[]

  @@index([businessId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  purchaseId String  @map("purchase_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryMovement {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  productId       String              @map("product_id") @db.Uuid
  quantity        Int
  reason          StockMovementReason
  note            String?
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([productId])
  @@map("inventory_movements")
}

model Membership {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  role       BusinessRole
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

model Invitation {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  email           String
  role            BusinessRole
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  resolvedAt      DateTime?        @map("resolved_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User     @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@map("invitations")
}

model RefreshToken {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  familyId            String    @map("family_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdByIp         String?   @map("created_by_ip")
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
